   readonly artEligibility: ArtEligibility;
   readonly provenanceSourceIds: readonly string[];
   readonly emittedAt: string;
+  /** Metadatos de transporte: permiten correlacionar un CONTENT_ID entre repos. */
+  readonly sourceSystem: string;
+  readonly sourceRevision: string;
+  readonly provenanceDigest: string;
 };
 
 export type ContractIssue = { readonly path: string; readonly message: string };
@@ -132,6 +136,17 @@ export function readCanonicalEnvelope(input: unknown): ContractResult {
     });
   }
 
+  // Transporte. Un digest malformado aparenta trazabilidad: peor que ausente.
+  const digest = input.provenance_digest;
+  if (digest !== undefined && !/^[0-9a-fA-F]{64}$/.test(String(digest))) {
+    issues.push(issue("envelope.provenance_digest", "se espera sha256 hex de 64 caracteres"));
+  }
+  if (input.source_system !== undefined && input.source_system !== "Psyche-creation") {
+    issues.push(
+      issue("envelope.source_system", "el único emisor autorizado del canon es Psyche-creation"),
+    );
+  }
+
   const rawClaims = input.claims;
   const claims: CanonicalClaimRef[] = [];
   if (!Array.isArray(rawClaims) || rawClaims.length === 0) {
@@ -186,6 +201,9 @@ export function readCanonicalEnvelope(input: unknown): ContractResult {
       artEligibility: input.art_eligibility as ArtEligibility,
       provenanceSourceIds: sourceIds,
       emittedAt: nonEmpty(input.emitted_at) ? input.emitted_at : "",
+      sourceSystem: nonEmpty(input.source_system) ? input.source_system : "",
+      sourceRevision: nonEmpty(input.source_revision) ? input.source_revision : "",
+      provenanceDigest: nonEmpty(input.provenance_digest) ? input.provenance_digest : "",
     },
   };
 }

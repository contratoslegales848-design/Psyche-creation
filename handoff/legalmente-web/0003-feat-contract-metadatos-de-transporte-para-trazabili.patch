diff --git a/src/lib/psyche-contract/contract.test.ts b/src/lib/psyche-contract/contract.test.ts
index edb6c5d..9a93db5 100644
--- a/src/lib/psyche-contract/contract.test.ts
+++ b/src/lib/psyche-contract/contract.test.ts
@@ -193,3 +193,39 @@ test("todas las fixtures del snapshot son JSON válido y con versión declarada"
     assert.ok(typeof f.content_id === "string", `${n} sin content_id`);
   }
 });
+
+test("metadatos de transporte se leen y se validan", () => {
+  const env = okEnvelope("valid_ready");
+  assert.equal(env.sourceSystem, "Psyche-creation");
+  assert.match(env.provenanceDigest, /^[0-9a-f]{64}$/);
+  assert.ok(env.sourceRevision.length > 0);
+});
+
+test("digest malformado se rechaza", () => {
+  assert.equal(readCanonicalEnvelope(load("bad_provenance_digest")).ok, false);
+});
+
+test("emisor no autorizado se rechaza", () => {
+  const env = { ...(load("valid_ready") as Record<string, unknown>), source_system: "otro" };
+  assert.equal(readCanonicalEnvelope(env).ok, false);
+});
+
+test("el estado canónico nunca es opaco", () => {
+  // Contraste explícito con el adapter de PR #27, que aceptaba cualquier string
+  // como canonicalStatus — incluidos "APPROVED" y "LIVE".
+  for (const falso of ["APPROVED", "LIVE", "PUBLISHABLE", "SUPER_APTO"]) {
+    const env = { ...(load("valid_ready") as Record<string, unknown>), claim_state: falso };
+    assert.equal(readCanonicalEnvelope(env).ok, false, `${falso} no debe aceptarse`);
+  }
+});
+
+test("tolerancia a campos futuros es una decisión declarada, no un descuido", () => {
+  // PR #27 usaba .strict() y rechazaba cualquier campo extra. Aquí se elige lo
+  // contrario a propósito: Psyche puede añadir campos opcionales en v1 sin
+  // romper a los consumidores desplegados. Un cambio incompatible exige subir
+  // schema_version, y entonces el consumidor falla cerrado.
+  const conExtras = { ...(load("valid_ready") as Record<string, unknown>), campo_v1_futuro: "x" };
+  assert.equal(readCanonicalEnvelope(conExtras).ok, true);
+  const otraVersion = { ...(load("valid_ready") as Record<string, unknown>), schema_version: "2.0" };
+  assert.equal(readCanonicalEnvelope(otraVersion).ok, false);
+});

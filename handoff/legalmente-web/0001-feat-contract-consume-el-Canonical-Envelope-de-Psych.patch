@@ -0,0 +1,150 @@
+/**
+ * Mapeo canon → tipos de presentación de la web.
+ *
+ * Aquí es donde la autoridad podría escaparse hacia arriba, así que la regla es
+ * explícita: `VisualOutputState` se DERIVA de los campos canónicos y jamás se
+ * acepta del exterior. La web no puede declarar `READY_FOR_VISUAL` por su cuenta;
+ * solo puede reconocerlo cuando Psyche ya lo dice.
+ */
+
+import type { VisualOutputState } from "../ecosystem-kernel";
+import type { CanonicalEnvelope } from "./index";
+
+/** Procedencia de cada valor que la web muestra. Nunca se presenta un snapshot como dato en vivo. */
+export const PROVENANCE_KINDS = [
+  "CANONICAL",
+  "DERIVED",
+  "SNAPSHOT",
+  "EXPERIMENTAL",
+  "UNKNOWN",
+  "NO_MEDIDO",
+] as const;
+export type ProvenanceKind = (typeof PROVENANCE_KINDS)[number];
+
+export type ProvenancedValue<T> = {
+  readonly value: T;
+  readonly provenance: ProvenanceKind;
+  readonly source: string;
+  readonly derivation?: string;
+  readonly observedAt?: string;
+  readonly owner?: string;
+  readonly freshness?: string;
+  readonly confidence?: "HIGH" | "MEDIUM" | "LOW" | "UNKNOWN";
+};
+
+/**
+ * Deriva el estado visual SOLO desde el canon.
+ *
+ * READY_FOR_VISUAL exige, todo a la vez y decidido aguas arriba: claim apto,
+ * fuente verificada, gate jurídico abierto y elegibilidad declarada. Si algo
+ * falta, el resultado es un estado de espera — nunca uno de avance.
+ */
+export function deriveVisualOutputState(envelope: CanonicalEnvelope): VisualOutputState {
+  if (envelope.claimState === "BLOQUEADO") return "NOT_PUBLISHED";
+  if (envelope.sourceState !== "VERIFICADA") return "HOLD_SOURCE";
+  if (envelope.claimState !== "APTO_PARA_NARRATIVA") return "DRAFT";
+  if (envelope.legalGateState !== "ABIERTO") return "DRAFT";
+  if (envelope.artEligibility !== "ELEGIBLE") return "DRAFT";
+  return "READY_FOR_VISUAL";
+}
+
+/** ¿Cubre el canon este territorio? La web no amplía cobertura territorial. */
+export function supportsTerritory(envelope: CanonicalEnvelope, territory: string): boolean {
+  if (envelope.jurisdictionLayer === "CAPA_A_TRANSVERSAL") return true;
+  return envelope.territories.includes(territory);
+}
+
+/** Vista lista para UI. Todo campo de autoridad viene etiquetado como CANONICAL. */
+export type CanonicalPresentation = {
+  readonly contentId: ProvenancedValue<string>;
+  readonly claimState: ProvenancedValue<string>;
+  readonly sourceState: ProvenancedValue<string>;
+  readonly legalGateState: ProvenancedValue<string>;
+  readonly jurisdictionLayer: ProvenancedValue<string>;
+  readonly territories: ProvenancedValue<readonly string[]>;
+  readonly visualOutputState: ProvenancedValue<VisualOutputState>;
+  readonly claimCount: ProvenancedValue<number>;
+  readonly sourceCount: ProvenancedValue<number>;
+};
+
+export function toPresentation(envelope: CanonicalEnvelope): CanonicalPresentation {
+  const canonical = <T>(value: T): ProvenancedValue<T> => ({
+    value,
+    provenance: "CANONICAL",
+    source: "psyche-creation:canonical-envelope",
+    observedAt: envelope.emittedAt,
+    owner: "psyche-creation",
+    confidence: "HIGH",
+  });
+
+  return {
+    contentId: canonical(envelope.contentId),
+    claimState: canonical(envelope.claimState),
+    sourceState: canonical(envelope.sourceState),
+    legalGateState: canonical(envelope.legalGateState),
+    jurisdictionLayer: canonical(envelope.jurisdictionLayer),
+    territories: canonical(envelope.territories),
+    visualOutputState: {
+      value: deriveVisualOutputState(envelope),
+      provenance: "DERIVED",
+      source: "psyche-creation:canonical-envelope",
+      derivation:
+        "deriveVisualOutputState(claimState, sourceState, legalGateState, artEligibility)",
+      observedAt: envelope.emittedAt,
+      owner: "legalmente-web",
+      confidence: "HIGH",
+    },
+    claimCount: {
+      value: envelope.claims.length,
+      provenance: "DERIVED",
+      source: "psyche-creation:canonical-envelope",
+      derivation: "envelope.claims.length",
+      observedAt: envelope.emittedAt,
+      owner: "legalmente-web",
+      confidence: "HIGH",
+    },
+    sourceCount: {
+      value: envelope.provenanceSourceIds.length,
+      provenance: "DERIVED",
+      source: "psyche-creation:canonical-envelope",
+      derivation: "envelope.provenance.sources.length",
+      observedAt: envelope.emittedAt,
+      owner: "legalmente-web",
+      confidence: "HIGH",
+    },
+  };
+}
+
+/**
+ * Marca un valor que proviene de un snapshot o de una fixture.
+ *
+ * Existe para que nada tomado de un fichero estático pueda presentarse como
+ * medición en vivo: quien lo use debe pasar cuándo se observó.
+ */
+export function asSnapshot<T>(
+  value: T,
+  source: string,
+  observedAt: string,
+  owner = "legalmente-web",
+): ProvenancedValue<T> {
+  return {
+    value,
+    provenance: "SNAPSHOT",
+    source,
+    observedAt,
+    owner,
+    freshness: `snapshot tomado en ${observedAt}; no es un dato en vivo`,
+    confidence: "MEDIUM",
+  };
+}
+
+/** Valor que nadie ha medido todavía. Preferible a inventar un cero. */
+export function notMeasured<T>(value: T, source: string): ProvenancedValue<T> {
+  return {
+    value,
+    provenance: "NO_MEDIDO",
+    source,
+    freshness: "sin medición",
+    confidence: "UNKNOWN",
+  };
+}
-- 

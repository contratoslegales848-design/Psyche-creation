diff --git a/src/lib/psyche-contract/README.md b/src/lib/psyche-contract/README.md
new file mode 100644
index 0000000..09728ff
--- /dev/null
+++ b/src/lib/psyche-contract/README.md
@@ -0,0 +1,42 @@
+# Psyche Contract — consumidor estricto
+
+Esta carpeta es **la única frontera autorizada** por la que datos canónicos de
+`Psyche-creation` entran en `legalmente-web`.
+
+```
+PSYCHE CANON
+     ↓
+CANONICAL ENVELOPE v1
+     ↓
+adapter estricto (este módulo)
+     ↓
+Operations Engine / Product UI
+```
+
+## Reglas
+
+- **Psyche es la autoridad.** Web muestra, agrupa, ordena, formatea y prepara UX.
+- **Web nunca**: aprueba un claim, recalcula validación jurídica, eleva
+  jurisdicción, infiere suficiencia de fuentes, cambia hashes canónicos, abre un
+  gate jurídico, reinterpreta `BLOCKED` como listo, ni convierte `UNKNOWN` en éxito.
+- **Ningún componente de React parsea el envelope.** Se importa desde aquí o no
+  se importa.
+- **Fail-closed**: versión desconocida, estado desconocido, procedencia ausente o
+  campo requerido ausente ⇒ se rechaza. No hay *fallback* optimista.
+
+## Fixtures
+
+`fixtures/` es un **snapshot versionado** de las fixtures que produce Psyche en
+`contract/fixtures/`. No hay acoplamiento en tiempo de ejecución entre repos: se
+copian ficheros y `contract.test.ts` comprueba compatibilidad.
+
+Al actualizar el contrato en Psyche, recopiar el snapshot y volver a ejecutar
+`npm run test:psyche-contract`. Si la versión del esquema cambia, este consumidor
+debe rechazarla hasta que se implemente explícitamente.
+
+## Migración a v2
+
+`SUPPORTED_SCHEMA_VERSIONS` es la lista blanca. Para adoptar una v2:
+añadir la versión, mapear los campos nuevos, y mantener v1 mientras Psyche la
+siga emitiendo. Un envelope de versión no listada **siempre** se rechaza — nunca
+se interpreta con optimismo.
diff --git a/src/lib/psyche-contract/contract.test.ts b/src/lib/psyche-contract/contract.test.ts
new file mode 100644
index 0000000..edb6c5d
--- /dev/null
+++ b/src/lib/psyche-contract/contract.test.ts
@@ -0,0 +1,195 @@
+/**
+ * Contract tests del consumidor de Psyche.
+ *
+ * Se ejecutan contra el snapshot versionado de fixtures que produce Psyche en
+ * `contract/fixtures/`. Sin acoplamiento en tiempo de ejecución entre repos.
+ */
+
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import test from "node:test";
+
+import { readCanonicalEnvelope, SUPPORTED_SCHEMA_VERSIONS } from "./index";
+import {
+  asSnapshot,
+  deriveVisualOutputState,
+  notMeasured,
+  supportsTerritory,
+  toPresentation,
+} from "./mapping";
+
+const FIXTURES = join(process.cwd(), "src/lib/psyche-contract/fixtures");
+const load = (name: string): unknown =>
+  JSON.parse(readFileSync(join(FIXTURES, `${name}.json`), "utf8"));
+
+const okEnvelope = (name: string) => {
+  const r = readCanonicalEnvelope(load(name));
+  assert.equal(r.ok, true, `${name} debía ser aceptada`);
+  if (!r.ok) throw new Error("inalcanzable");
+  return r.envelope;
+};
+
+test("versión soportada se acepta", () => {
+  const env = okEnvelope("valid_ready");
+  assert.equal(env.contentId, "LM-FIXTURE-001");
+  assert.ok(SUPPORTED_SCHEMA_VERSIONS.includes(env.schemaVersion as "1.0"));
+  assert.equal(env.claims.length, 1);
+  assert.equal(env.provenanceSourceIds.length, 1);
+});
+
+test("versión desconocida falla cerrado", () => {
+  const r = readCanonicalEnvelope(load("unknown_version"));
+  assert.equal(r.ok, false);
+  if (r.ok) return;
+  assert.match(r.issues[0].message, /no soportada/);
+});
+
+test("estado canónico desconocido falla cerrado", () => {
+  assert.equal(readCanonicalEnvelope(load("unknown_state")).ok, false);
+});
+
+test("procedencia ausente no se infiere como válida", () => {
+  const r = readCanonicalEnvelope(load("missing_provenance"));
+  assert.equal(r.ok, false);
+  if (r.ok) return;
+  assert.ok(r.issues.some((i) => i.path.includes("provenance")));
+});
+
+test("envelope ausente o con forma inválida", () => {
+  for (const malo of [null, undefined, [], "texto", 42, true]) {
+    assert.equal(readCanonicalEnvelope(malo).ok, false);
+  }
+});
+
+test("intento de escalamiento de autoridad se rechaza", () => {
+  const r = readCanonicalEnvelope(load("authority_escalation_attempt"));
+  assert.equal(r.ok, false);
+  if (r.ok) return;
+  assert.ok(r.issues.some((i) => /BLOQUEADO|incoherente/.test(i.message)));
+});
+
+test("BLOQUEADO sigue BLOQUEADO a través de todo el mapeo", () => {
+  const env = okEnvelope("blocked_claim");
+  assert.equal(env.claimState, "BLOQUEADO");
+  assert.equal(env.artEligibility, "NO_ELEGIBLE");
+  assert.equal(deriveVisualOutputState(env), "NOT_PUBLISHED");
+
+  const p = toPresentation(env);
+  assert.equal(p.claimState.value, "BLOQUEADO");
+  assert.equal(p.visualOutputState.value, "NOT_PUBLISHED");
+  assert.equal(p.claimState.provenance, "CANONICAL");
+
+  // Ninguna agregación ni orden ni formato puede convertirlo en listo.
+  const agregado = [env, okEnvelope("valid_ready")].map(deriveVisualOutputState);
+  assert.ok(agregado.includes("NOT_PUBLISHED"));
+  assert.equal(agregado.filter((s) => s === "READY_FOR_VISUAL").length, 1);
+});
+
+test("fuente pendiente no habilita arte", () => {
+  const env = okEnvelope("source_pending");
+  assert.equal(env.sourceState, "PENDIENTE");
+  assert.equal(deriveVisualOutputState(env), "HOLD_SOURCE");
+});
+
+test("territorio no cubierto sigue no cubierto", () => {
+  const env = okEnvelope("unsupported_territory");
+  assert.deepEqual(env.territories, []);
+  assert.equal(supportsTerritory(env, "México"), false);
+  assert.equal(deriveVisualOutputState(env), "DRAFT");
+});
+
+test("capa A transversal cubre cualquier territorio", () => {
+  const env = okEnvelope("valid_ready");
+  assert.equal(env.jurisdictionLayer, "CAPA_A_TRANSVERSAL");
+  assert.equal(supportsTerritory(env, "Chile"), true);
+});
+
+test("solo el envelope válido y completo llega a READY_FOR_VISUAL", () => {
+  assert.equal(deriveVisualOutputState(okEnvelope("valid_ready")), "READY_FOR_VISUAL");
+});
+
+test("la web no puede declarar READY_FOR_VISUAL por su cuenta", () => {
+  // Un envelope que se autodeclara elegible pero con el gate cerrado se rechaza
+  // en la frontera; nunca llega al mapeo.
+  const forjado = {
+    ...(load("valid_ready") as Record<string, unknown>),
+    legal_gate_state: "CERRADO",
+  };
+  assert.equal(readCanonicalEnvelope(forjado).ok, false);
+
+  // Y aunque alguien intentara pasar un outputState "listo" por fuera, el mapeo
+  // no lo lee: deriva desde el canon.
+  const conEstadoFalso = {
+    ...(load("blocked_claim") as Record<string, unknown>),
+    outputState: "READY_FOR_VISUAL",
+  };
+  const r = readCanonicalEnvelope(conEstadoFalso);
+  assert.equal(r.ok, true);
+  if (!r.ok) return;
+  assert.equal(deriveVisualOutputState(r.envelope), "NOT_PUBLISHED");
+});
+
+test("campos opcionales futuros se toleran (compatibilidad hacia adelante)", () => {
+  const conExtras = {
+    ...(load("valid_ready") as Record<string, unknown>),
+    campo_futuro: "algo",
+    otro: 123,
+  };
+  assert.equal(readCanonicalEnvelope(conExtras).ok, true);
+});
+
+test("hash canónico se transporta, nunca se recalcula", () => {
+  const env = okEnvelope("valid_ready");
+  const original = (load("valid_ready") as { claims: { approved_claim_hash: string }[] })
+    .claims[0].approved_claim_hash;
+  assert.equal(env.claims[0].approvedClaimHash, original);
+});
+
+test("claim sin hash aprobado se rechaza", () => {
+  const sinHash = {
+    ...(load("valid_ready") as Record<string, unknown>),
+    claims: [{ claim_id: "c1" }],
+  };
+  assert.equal(readCanonicalEnvelope(sinHash).ok, false);
+});
+
+test("toda la presentación declara su procedencia", () => {
+  const p = toPresentation(okEnvelope("valid_ready"));
+  for (const [clave, valor] of Object.entries(p)) {
+    assert.ok(valor.provenance, `${clave} sin procedencia`);
+    assert.ok(valor.source, `${clave} sin fuente`);
+  }
+  assert.equal(p.contentId.provenance, "CANONICAL");
+  assert.equal(p.claimCount.provenance, "DERIVED");
+  assert.ok(p.claimCount.derivation);
+});
+
+test("un snapshot nunca se presenta como dato en vivo", () => {
+  const s = asSnapshot(42, "fixture:inventario", "2026-08-31T00:00:00Z");
+  assert.equal(s.provenance, "SNAPSHOT");
+  assert.ok(s.observedAt);
+  assert.match(s.freshness ?? "", /no es un dato en vivo/);
+
+  const n = notMeasured(0, "metricas:instagram");
+  assert.equal(n.provenance, "NO_MEDIDO");
+  assert.equal(n.confidence, "UNKNOWN");
+});
+
+test("todas las fixtures del snapshot son JSON válido y con versión declarada", () => {
+  const nombres = [
+    "valid_ready",
+    "blocked_claim",
+    "source_pending",
+    "unsupported_territory",
+    "missing_provenance",
+    "unknown_version",
+    "unknown_state",
+    "authority_escalation_attempt",
+  ];
+  for (const n of nombres) {
+    const f = load(n) as Record<string, unknown>;
+    assert.ok(typeof f.schema_version === "string", `${n} sin schema_version`);
+    assert.ok(typeof f.content_id === "string", `${n} sin content_id`);
+  }
+});

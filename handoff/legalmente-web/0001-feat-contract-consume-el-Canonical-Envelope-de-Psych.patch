diff --git a/src/lib/psyche-contract/index.ts b/src/lib/psyche-contract/index.ts
new file mode 100644
index 0000000..7fd63da
--- /dev/null
+++ b/src/lib/psyche-contract/index.ts
@@ -0,0 +1,191 @@
+/**
+ * Consumidor estricto del Canonical Envelope de Psyche-creation.
+ *
+ * Psyche es la autoridad; este módulo la transporta sin recalcularla. Es la
+ * única frontera por la que el canon entra en la web: ningún componente debe
+ * parsear un envelope por su cuenta.
+ *
+ * Todo lo desconocido falla cerrado. No existe fallback optimista.
+ */
+
+/** Versiones que este consumidor sabe interpretar. Lista blanca, no rango. */
+export const SUPPORTED_SCHEMA_VERSIONS = ["1.0"] as const;
+
+export const CLAIM_STATES = [
+  "APTO_PARA_NARRATIVA",
+  "REQUIERE_INVESTIGACION",
+  "BLOQUEADO",
+  "PENDIENTE",
+] as const;
+export const SOURCE_STATES = ["VERIFICADA", "PENDIENTE", "INSUFICIENTE"] as const;
+export const LEGAL_GATE_STATES = ["ABIERTO", "CERRADO"] as const;
+export const JURISDICTION_LAYERS = [
+  "CAPA_A_TRANSVERSAL",
+  "CAPA_B_VARIABLE",
+  "CAPA_C_NACIONAL",
+  "NO_APLICA",
+] as const;
+export const ART_ELIGIBILITY = ["ELEGIBLE", "NO_ELEGIBLE"] as const;
+
+export type ClaimState = (typeof CLAIM_STATES)[number];
+export type SourceState = (typeof SOURCE_STATES)[number];
+export type LegalGateState = (typeof LEGAL_GATE_STATES)[number];
+export type JurisdictionLayer = (typeof JURISDICTION_LAYERS)[number];
+export type ArtEligibility = (typeof ART_ELIGIBILITY)[number];
+
+export type CanonicalClaimRef = {
+  readonly claimId: string;
+  readonly approvedClaimHash: string;
+  readonly textoExacto?: string;
+};
+
+/**
+ * Vista de solo lectura del canon. Todos los campos de autoridad llegan tal
+ * cual desde Psyche; ninguno se deriva aquí.
+ */
+export type CanonicalEnvelope = {
+  readonly schemaVersion: string;
+  readonly contentId: string;
+  readonly claimState: ClaimState;
+  readonly sourceState: SourceState;
+  readonly legalGateState: LegalGateState;
+  readonly jurisdictionLayer: JurisdictionLayer;
+  readonly territories: readonly string[];
+  readonly claims: readonly CanonicalClaimRef[];
+  readonly artEligibility: ArtEligibility;
+  readonly provenanceSourceIds: readonly string[];
+  readonly emittedAt: string;
+};
+
+export type ContractIssue = { readonly path: string; readonly message: string };
+export type ContractResult =
+  | { readonly ok: true; readonly envelope: CanonicalEnvelope; readonly issues: readonly [] }
+  | { readonly ok: false; readonly issues: readonly ContractIssue[] };
+
+const isRecord = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+const nonEmpty = (v: unknown): v is string => typeof v === "string" && v.trim().length > 0;
+const issue = (path: string, message: string): ContractIssue => ({ path, message });
+const oneOf = <T extends readonly string[]>(list: T, v: unknown): v is T[number] =>
+  typeof v === "string" && (list as readonly string[]).includes(v);
+
+/**
+ * Punto de entrada del límite de confianza.
+ *
+ * Devuelve el envelope tipado o la lista de problemas. Nunca lanza, nunca
+ * devuelve algo a medias y nunca eleva autoridad.
+ */
+export function readCanonicalEnvelope(input: unknown): ContractResult {
+  if (!isRecord(input)) {
+    return { ok: false, issues: [issue("envelope", "ausente o con forma inválida")] };
+  }
+
+  // La versión se comprueba ANTES que nada: un envelope de versión desconocida
+  // no se inspecciona, porque no sabemos qué significan sus campos.
+  const version = input.schema_version;
+  if (!oneOf(SUPPORTED_SCHEMA_VERSIONS, version)) {
+    return {
+      ok: false,
+      issues: [
+        issue(
+          "envelope.schema_version",
+          `versión no soportada: ${JSON.stringify(version)}. Fail-closed: no se consume.`,
+        ),
+      ],
+    };
+  }
+
+  const issues: ContractIssue[] = [];
+  if (!nonEmpty(input.content_id)) issues.push(issue("envelope.content_id", "requerido"));
+
+  if (!oneOf(CLAIM_STATES, input.claim_state)) {
+    issues.push(issue("envelope.claim_state", "estado canónico desconocido"));
+  }
+  if (!oneOf(SOURCE_STATES, input.source_state)) {
+    issues.push(issue("envelope.source_state", "estado de fuente desconocido"));
+  }
+  if (!oneOf(LEGAL_GATE_STATES, input.legal_gate_state)) {
+    issues.push(issue("envelope.legal_gate_state", "estado de gate desconocido"));
+  }
+  if (!oneOf(JURISDICTION_LAYERS, input.jurisdiction_layer)) {
+    issues.push(issue("envelope.jurisdiction_layer", "capa jurisdiccional desconocida"));
+  }
+  if (!oneOf(ART_ELIGIBILITY, input.art_eligibility)) {
+    issues.push(issue("envelope.art_eligibility", "elegibilidad desconocida"));
+  }
+
+  // Procedencia: nunca se infiere como válida si falta.
+  const provenance = input.provenance;
+  const sources = isRecord(provenance) ? provenance.sources : undefined;
+  const sourceIds: string[] = [];
+  if (!Array.isArray(sources) || sources.length === 0) {
+    issues.push(
+      issue("envelope.provenance", "ausente o sin fuentes: no se infiere procedencia válida"),
+    );
+  } else {
+    sources.forEach((s: unknown, i: number) => {
+      if (!isRecord(s) || !nonEmpty(s.id)) {
+        issues.push(issue(`envelope.provenance.sources[${i}]`, "fuente sin id"));
+      } else {
+        sourceIds.push(s.id);
+      }
+    });
+  }
+
+  const rawClaims = input.claims;
+  const claims: CanonicalClaimRef[] = [];
+  if (!Array.isArray(rawClaims) || rawClaims.length === 0) {
+    issues.push(issue("envelope.claims", "el envelope no transporta claims"));
+  } else {
+    rawClaims.forEach((c: unknown, i: number) => {
+      if (!isRecord(c) || !nonEmpty(c.claim_id) || !nonEmpty(c.approved_claim_hash)) {
+        issues.push(
+          issue(`envelope.claims[${i}]`, "requiere claim_id y approved_claim_hash"),
+        );
+        return;
+      }
+      claims.push({
+        claimId: c.claim_id,
+        approvedClaimHash: c.approved_claim_hash,
+        textoExacto: nonEmpty(c.texto_exacto) ? c.texto_exacto : undefined,
+      });
+    });
+  }
+
+  // Incoherencias que delatan un intento de elevar autoridad aguas arriba.
+  if (input.legal_gate_state === "ABIERTO" && input.claim_state !== "APTO_PARA_NARRATIVA") {
+    issues.push(
+      issue("envelope", "incoherente: gate ABIERTO con claim que no es APTO_PARA_NARRATIVA"),
+    );
+  }
+  if (input.art_eligibility === "ELEGIBLE" && input.legal_gate_state !== "ABIERTO") {
+    issues.push(issue("envelope", "incoherente: elegible para arte con el gate cerrado"));
+  }
+  if (input.claim_state === "BLOQUEADO" && input.art_eligibility === "ELEGIBLE") {
+    issues.push(issue("envelope", "un claim BLOQUEADO no puede ser elegible para arte"));
+  }
+
+  if (issues.length > 0) return { ok: false, issues };
+
+  const territories = Array.isArray(input.territories)
+    ? input.territories.filter(nonEmpty)
+    : [];
+
+  return {
+    ok: true,
+    issues: [],
+    envelope: {
+      schemaVersion: version,
+      contentId: input.content_id as string,
+      claimState: input.claim_state as ClaimState,
+      sourceState: input.source_state as SourceState,
+      legalGateState: input.legal_gate_state as LegalGateState,
+      jurisdictionLayer: input.jurisdiction_layer as JurisdictionLayer,
+      territories,
+      claims,
+      artEligibility: input.art_eligibility as ArtEligibility,
+      provenanceSourceIds: sourceIds,
+      emittedAt: nonEmpty(input.emitted_at) ? input.emitted_at : "",
+    },
+  };
+}
